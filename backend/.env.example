DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL_SYNC=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

REDIS_HOST=HOST
REDIS_PORT=6379
REDIS_PASSWORD=PASSWORD

CORS_ORIGINS=["http://localhost:5173","http://localhost:8082"]

# Standalone development only. Production must use true and a reachable UVMS.
UVMS_INTERNAL_URL=
UVMS_MODULE_CODE=statistik
UVMS_SESSION_COOKIE_NAME=uvms_session
UVMS_AUTHORIZE_TIMEOUT_SEC=5
UVMS_AUTH_ENABLED=false

LOITERING_PORTS_FILE=/data/ports.csv
